<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <script>
    window.apps = JSON.parse('<%- JSON.stringify(apps).replace(/</g, '\\u003c') %>')
    window.idps = JSON.parse('<%- JSON.stringify(idps).replace(/</g, '\\u003c') %>')

    console.log({
      apps,
      idps
    })

  </script>
</head>

<body class="bg-gray-100 flex flex-col items-center justify-center h-screen">

    <% if (message === '') { %>
      <h1 class="text-3xl font-bold mb-6">External Application</h1>
      <% if (configId === '') { %>
      <div class="mb-6 w-full max-w-xs">
          <label for="appId" class="block text-gray-700 text-sm font-semibold mb-2">App ID</label>
          <select id="appId"
            class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:border-blue-500">
            <option value="" disabled selected>Select your App ID</option>
            <% apps.forEach(function(app) { %>
              <option value="<%= app.appId %>">
                <%= app.appName %>
              </option>
              <% }) %>
          </select>
          <div id="buttons" class="buttons">
          </div>
      </div>
      <% } %>
        <div id="message" class="text-lg text-gray-700 mb-4">Authentication in progress ...</div> <!-- To display messages from the popup -->
        <div>
          <button id="redirectBtn" style="display:none" onclick="redirectToExternalApp()"
            class="bg-green-500 text-white font-semibold py-2 px-4 rounded shadow hover:bg-green-600 transition duration-200">Click
            to continue to external app</button>
        </div>
  <% } else { %>
      <div id="message" class="text-lg text-gray-700 mb-4"><%= message %></div>
  <% } %>
  <script>
    const toggleRedirectButton = (isVisible) => {
      if (isVisible) {
        redirectBtn.style.display = 'block'
      } else {
        redirectBtn.style.display = 'none'
      }
    }

    function useOpenIdPopupLogin(providerId, options = {}) {
      let state = {
        redirectUrl: ''
      }
      window.addEventListener('message', function (event) {
        console.log('event', {
          event
        })
        if (event.data.type === `${providerId.toLowerCase()}_auth`) {
          state.redirectUrl = event.data.data.redirectUrl
          if (state.redirectUrl) {
            document.getElementById('message').innerText = 'Authentication success : ';
          } else {
            document.getElementById('message').innerText = 'Received from popup: ' + JSON.stringify(event.data);
          }
          if (options.onPopupDataReceived) {
            options.onPopupDataReceived(event.data, state)
          }
        }
      });

      function triggerPopup() {
        window.open(`/auth/authorize/${providerId}?appId=${window.appId.value || ''}`, 'Popup Window', 'width=600,height=400');
      }

      function bindBtn(el) {
        el.addEventListener('click', triggerPopup)
      }

      if (options.el) {
        bindBtn(options.el)
      }

      return {
        getState() {
          return state
        },
        bindBtn
      }
    }

    let getState = null

    <% if (configId !== '') { %>
    const { getState: getAppState } = useOpenIdPopupLogin('config', {
      onPopupDataReceived(data, state) {
        toggleRedirectButton(!!state.redirectUrl)
        getState = getAppState
      }
    })
    window.open(`/auth/authorize/config/<%= configId %>`, 'Popup Window', 'width=600,height=400');
    <% } else { %>
    window.idps.forEach(app => {
      console.log('Adding button for idp', {app})

      let div = document.createElement('div')
      div.id = `buttons-${app.appId}`
      div.innerHTML = `<button
      id="button_${app.appId}"
       class="mt-4 w-full bg-blue-500 text-white font-semibold py-2 px-4 rounded shadow hover:bg-blue-600 transition duration-200">
      Login with ${app.appName}
    </button>`
      div.addEventListener('click', () => {

      })
      window.buttons.appendChild(div)

      const { getState: getAppState } = useOpenIdPopupLogin(app.appId, {
        el: window[`button_${app.appId}`],
        onPopupDataReceived(data, state) {
          toggleRedirectButton(!!state.redirectUrl)
          getState = getAppState
        }
      })
    })
    <% } %>

    function redirectToExternalApp() {
      if (getState().redirectUrl) {
        location.href = getState().redirectUrl
      }
    }
  </script>

</body>

</html>