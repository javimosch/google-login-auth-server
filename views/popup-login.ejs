<!DOCTYPE html>
<html>

<head>
  <title>Google Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    <% if (!user || Object.keys(user).length === 0) { %>
      const providerId = '<%= providerId || "" %>';  
      window.location.href = `/auth/authorize/${providerId}`;
    <% } %>
  </script>
</head>

<body class="flex items-center justify-center h-screen bg-gray-200">
  <% if (user) { %>
    <script>
        const providerId = '<%= providerId || "" %>';  
        const appId = '<%= appId || "" %>';
        const configId = '<%= configId || "" %>';
        const appUrl = '<%= appUrl || "" %>';

        function initialize() {
          const message = {
            type: configId === '' ? `${providerId}_auth` : 'config_auth',
            data: {
              user: {
                name: '<%= user.name %>', // User's name
                email: '<%= user.email %>', // User's email
                picture: '<%= user.picture %>'  // User's profile picture
              },
              token: '<%= user.token || "" %>',
              redirectUrl: '<%= user.redirectUrl || "" %>'
            }
          };
          console.log({
            message
          })

          let email = message.data.user.email
          let linkFields = `<%= linkFields %>`;

          if (!message.data.token) {
            // Split linkFields into an array
            const fieldsArray = linkFields.split(',');
            const formContainer = document.createElement('div');
            formContainer.className = 'bg-white p-6 rounded-lg shadow-md';

            // Create form
            const form = document.createElement('form');
            form.className = 'space-y-4';

            fieldsArray.forEach(field => {
              const inputGroup = document.createElement('div');
              inputGroup.className = 'flex flex-col';

              const label = document.createElement('label');
              label.className = 'font-bold mb-1';
              label.innerText = field.charAt(0).toUpperCase() + field.slice(1);
              inputGroup.appendChild(label);

              const input = document.createElement('input');
              input.type = field === 'password' ? 'password' : 'text'; // Set type to password if the field name is 'password'
              input.name = field;
              input.className = 'px-4 py-2 border rounded';
              input.required = true; // Make input required
              inputGroup.appendChild(input);

              form.appendChild(inputGroup);
            });

            const submitButton = document.createElement('button');
            submitButton.type = 'submit';
            submitButton.className = 'px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600';
            submitButton.innerText = 'Link Account';
            form.appendChild(submitButton);

            let loginAttemptNumber = 0;
            let attemptsLeft = 3;
            // Link form submission
            form.onsubmit = function (event) {
              loginAttemptNumber++;
              attemptsLeft--;
              event.preventDefault();
              const formData = new FormData(form);
              let linkedData = {};
              formData.forEach((value, key) => {
                linkedData[key] = value;
              });

              linkedData.email = email
              console.log('linkedData', {
                linkedData
              })

              if(!linkedData.email){
                alert(`We were unable to retrieve your email from your idp (${providerId}). Please verify account in your idp and try again.`)
                return
              }

              // Fetch to /link-account (POST) with linkedData as body
              fetch('/auth/link-account', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                  payload: linkedData,
                  loginAttemptNumber,
                  appId,
                  providerId,
                  configId
                })  // Send linkedData as JSON
              }).then(response => {
                  if (response.status === 422) {
                    // Show error message for invalid credentials
                    errorMessage.classList.remove('hidden');
                    setTimeout(() => {
                        errorMessage.classList.add('hidden');
                    }, 5000); // Hide after 5 seconds
                    throw new Error('Invalid credentials');
                } else if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                  return response.json();  // Parse the JSON from the response
                }).then(response => {
                  const redirectUrl = response.redirectUrl;
                  // You might want to do something with redirectUrl, like redirecting
                  if (!redirectUrl) {
                    console.error('Redirect URL not found in the response.');
                  }
                  message.data.redirectUrl = redirectUrl
                  message.data.token = response.token
                  window.opener.postMessage(message, '*');
                  window.close();
                })
                .catch(error => {
                  console.error('There was a problem with the fetch operation:', error);
                  if (loginAttemptNumber === 3) {
                    message.data.redirectUrl = appUrl
                    message.data.redirectToLogin = true
                    window.opener.postMessage(message, '*');
                    window.close();
                  } else {
                    alert(`An error occured during the login process. You have ${attemptsLeft} attempt${attemptsLeft > 1 ? 's' : ''} left.`);
                  }
                });
            }

            // Error message span
            const errorMessage = document.createElement('span');
            errorMessage.className = 'text-red-500 hidden';  // Initially hidden
            errorMessage.innerText = 'Invalid credentials';
            formContainer.appendChild(errorMessage);


            formContainer.appendChild(form);
            document.body.appendChild(formContainer);
          } else if (window.opener) {
            window.opener.postMessage(message, '*'); // Sends the message to the parent window
            window.close(); // Close the popup window
          }
        }
        initialize();
    </script>
    <% } %>
</body>

</html>